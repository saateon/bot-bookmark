# ============================================================
# نمونهٔ پیکربندی ربات لینک — این فایل را کپی کنید به .env
# و مقادیر واقعی را بگذارید. فایل .env هرگز به گیت نمی‌رود.
#   cp .env.example .env
# ============================================================

# --- تلگرام -------------------------------------------------
# توکن ربات از @BotFather
BOT_TOKEN=123456789:AA-your-bot-token

# آیدی عددی چت‌های مجاز (جداجدا با کاما). با فرستادن /id به بات،
# آیدی چت خودتان را بگیرید. خالی نگذارید — هرکس ربات را پیدا کند می‌تواند
# به بوکمارک‌های شما لینک اضافه کند.
ALLOWED_CHATS=123456789

# --- هوش مصنوعی (۹router) ------------------------------------
# API سازگار با OpenAI. از بیرون سرور AI:
AI_BASE_URL=https://router.vividplayer.net/v1
# اگر بات روی همان هاست AI و داخل شبکهٔ ai-network داکر باشد:
# AI_BASE_URL=http://9router:20128/v1

# کلید ROUTER_API_KEY (مثل logbot و Hermes)
AI_API_KEY=your-router-api-key

# نام مدل/کومبو از پنل ۹router
AI_MODEL=combo-name

# مستندات ۹router: مدل‌های reasoning توکن می‌خورند، زیر ۳۰۰۰ نگذارید
AI_MAX_TOKENS=3000
AI_TEMPERATURE=0.3
AI_TIMEOUT=90

# --- دادهٔ بوکمارک --------------------------------------------
# همان مسیر BM_DATA_DIR برنامهٔ PHP. روی سرور:
DATA_DIR=/security_folder/data/bookmark
# برای تست روی ویندوز، مسیر محلی بدهید، مثل:
# DATA_DIR=C:/Users/mansoor2/bookmark-test-data

# دستهٔ مقصد لینک‌های ربات
CATEGORY=bot

# --- عمومی -----------------------------------------------------
TITLE_MAX_LEN=80
FETCH_TIMEOUT=20
LOG_LEVEL=info
